# These variables are duplicated for install tree but they have different
# values for build tree.  LLVM_INCLUDE_DIRS contains both source
# and generated include directories while the following variables have
# them split.

# These are the "main" dirs
set(LLVM_MAIN_INCLUDE_DIR "@LLVM_CONFIG_MAIN_INCLUDE_DIR@")
set(LLVM_LIBRARY_DIR "@LLVM_CONFIG_LIBRARY_DIR@")

if(LLVM_ENABLE_RUST_RUSTDEMANGLE AND NOT TARGET llvm_rustdemangle)
  add_library(llvm_rustdemangle STATIC IMPORTED GLOBAL)
  set(_llvm_rustdemangle_location
    "@LLVM_CONFIG_RUSTDEMANGLE_IMPORTED_LOCATION@")
  if(_llvm_rustdemangle_location)
    set_target_properties(llvm_rustdemangle PROPERTIES
      IMPORTED_LOCATION "${_llvm_rustdemangle_location}")
  endif()
  set(_llvm_rustdemangle_locations
    "@LLVM_CONFIG_RUSTDEMANGLE_IMPORTED_LOCATIONS@")
  foreach(_llvm_rustdemangle_entry IN LISTS _llvm_rustdemangle_locations)
    string(FIND "${_llvm_rustdemangle_entry}" "=" _llvm_rustdemangle_sep)
    if(_llvm_rustdemangle_sep EQUAL -1)
      continue()
    endif()
    string(SUBSTRING "${_llvm_rustdemangle_entry}" 0
      ${_llvm_rustdemangle_sep} _llvm_rustdemangle_config)
    math(EXPR _llvm_rustdemangle_start "${_llvm_rustdemangle_sep} + 1")
    string(SUBSTRING "${_llvm_rustdemangle_entry}"
      ${_llvm_rustdemangle_start} -1 _llvm_rustdemangle_path)
    set_property(TARGET llvm_rustdemangle APPEND PROPERTY
      IMPORTED_CONFIGURATIONS "${_llvm_rustdemangle_config}")
    set_target_properties(llvm_rustdemangle PROPERTIES
      "IMPORTED_LOCATION_${_llvm_rustdemangle_config}"
      "${_llvm_rustdemangle_path}")
  endforeach()
  if(NOT _llvm_rustdemangle_location AND NOT _llvm_rustdemangle_locations)
    set_target_properties(llvm_rustdemangle PROPERTIES
      IMPORTED_LOCATION "${LLVM_LIBRARY_DIR}/@LLVM_RUSTDEMANGLE_LIBRARY_NAME@")
  endif()
  unset(_llvm_rustdemangle_location)
  unset(_llvm_rustdemangle_locations)
endif()

if(LLVM_ENABLE_RUST_DLANG AND NOT TARGET llvm_dlangdemangle)
  add_library(llvm_dlangdemangle STATIC IMPORTED GLOBAL)
  set(_llvm_dlangdemangle_location
    "@LLVM_CONFIG_DLANG_IMPORTED_LOCATION@")
  if(_llvm_dlangdemangle_location)
    set_target_properties(llvm_dlangdemangle PROPERTIES
      IMPORTED_LOCATION "${_llvm_dlangdemangle_location}")
  endif()
  set(_llvm_dlangdemangle_locations
    "@LLVM_CONFIG_DLANG_IMPORTED_LOCATIONS@")
  foreach(_llvm_dlangdemangle_entry IN LISTS _llvm_dlangdemangle_locations)
    string(FIND "${_llvm_dlangdemangle_entry}" "=" _llvm_dlangdemangle_sep)
    if(_llvm_dlangdemangle_sep EQUAL -1)
      continue()
    endif()
    string(SUBSTRING "${_llvm_dlangdemangle_entry}" 0
      ${_llvm_dlangdemangle_sep} _llvm_dlangdemangle_config)
    math(EXPR _llvm_dlangdemangle_start "${_llvm_dlangdemangle_sep} + 1")
    string(SUBSTRING "${_llvm_dlangdemangle_entry}"
      ${_llvm_dlangdemangle_start} -1 _llvm_dlangdemangle_path)
    set_property(TARGET llvm_dlangdemangle APPEND PROPERTY
      IMPORTED_CONFIGURATIONS "${_llvm_dlangdemangle_config}")
    set_target_properties(llvm_dlangdemangle PROPERTIES
      "IMPORTED_LOCATION_${_llvm_dlangdemangle_config}"
      "${_llvm_dlangdemangle_path}")
  endforeach()
  if(NOT _llvm_dlangdemangle_location AND NOT _llvm_dlangdemangle_locations)
    set_target_properties(llvm_dlangdemangle PROPERTIES
      IMPORTED_LOCATION "${LLVM_LIBRARY_DIR}/@LLVM_RUST_DLANG_LIBRARY_NAME@")
  endif()
  unset(_llvm_dlangdemangle_location)
  unset(_llvm_dlangdemangle_locations)
endif()

# Static LLVMSupport keeps Rust archives in its exported link interface. Define
# those targets so consumers never fall back to a bare -l<name> that requires
# the caller to add the LLVM library directory to its link search path.
set(_llvm_rust_library_dir "@LLVM_CONFIG_RUST_LIBRARY_DIR@")
set(_llvm_rust_configurations "@LLVM_CONFIG_RUST_CONFIGURATIONS@")
set(_llvm_rust_imported_targets
  "@LLVM_CONFIG_RUST_IMPORTED_TARGETS@")
foreach(_llvm_rust_entry IN LISTS _llvm_rust_imported_targets)
  if(NOT _llvm_rust_entry)
    continue()
  endif()
  string(REPLACE "|" ";" _llvm_rust_fields "${_llvm_rust_entry}")
  list(GET _llvm_rust_fields 0 _llvm_rust_target)
  list(GET _llvm_rust_fields 1 _llvm_rust_library)
  if(TARGET ${_llvm_rust_target})
    continue()
  endif()
  add_library(${_llvm_rust_target} STATIC IMPORTED GLOBAL)
  if(_llvm_rust_configurations)
    foreach(_llvm_rust_config IN LISTS _llvm_rust_configurations)
      string(TOUPPER "${_llvm_rust_config}" _llvm_rust_config_upper)
      set(_llvm_rust_location
        "${_llvm_rust_library_dir}/${_llvm_rust_library}")
      string(REPLACE "__LLVM_RUST_CONFIG__" "${_llvm_rust_config}"
        _llvm_rust_location "${_llvm_rust_location}")
      set_property(TARGET ${_llvm_rust_target} APPEND PROPERTY
        IMPORTED_CONFIGURATIONS "${_llvm_rust_config_upper}")
      set_target_properties(${_llvm_rust_target} PROPERTIES
        "IMPORTED_LOCATION_${_llvm_rust_config_upper}"
        "${_llvm_rust_location}")
    endforeach()
  else()
    set_target_properties(${_llvm_rust_target} PROPERTIES
      IMPORTED_LOCATION
      "${_llvm_rust_library_dir}/${_llvm_rust_library}")
  endif()
endforeach()
unset(_llvm_rust_library_dir)
unset(_llvm_rust_configurations)
unset(_llvm_rust_imported_targets)
unset(_llvm_rust_entry)
unset(_llvm_rust_fields)
unset(_llvm_rust_target)
unset(_llvm_rust_library)
unset(_llvm_rust_config)
unset(_llvm_rust_config_upper)
unset(_llvm_rust_location)

# This is a secondary one for generated files
set(LLVM_INCLUDE_DIR "@LLVM_CONFIG_INCLUDE_DIR@")

set(LLVM_DEFINITIONS "@LLVM_DEFINITIONS@")
set(LLVM_BINARY_DIR "@LLVM_CONFIG_BINARY_DIR@")
